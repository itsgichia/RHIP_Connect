# Copy into Railway Variables (never commit real secrets).
# Service root: repository root (so /data is available for seeding).

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Injected by Railway Postgres plugin (or paste DATABASE_URL)
# DATABASE_URL=postgresql://...

FRONTEND_URL=https://rhip-connect.vercel.app
CORS_ORIGINS=https://rhip-connect.vercel.app,https://rhip-connect-pdsr.vercel.app

DEMO_SKIP_EMAIL_VERIFICATION=true
DISABLE_EMAILS=true
USE_MOCK_AI=true

# Paste full Firebase service-account JSON as a single-line string:
FIREBASE_CREDENTIALS_JSON=

ADMIN_EMAIL=admin@rhip.edu.au
